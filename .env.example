PORT=5050
NODE_ENV=development

# Auth (use long random strings, 32+ chars; required when NODE_ENV=production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MongoDB connection string (keep the real one only in .env)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/express_app?retryWrites=true&w=majority

# Admin sessions (shorter than user sessions)
ADMIN_JWT_ACCESS_EXPIRES_IN=10m
ADMIN_JWT_REFRESH_EXPIRES_IN=1d

# Super admin, created once on first start if none exists.
# The password MUST be changed from the default before running with NODE_ENV=production.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@email.com
SUPER_ADMIN_PASSWORD=secret123
# Optional:
# SUPER_ADMIN_PHONE=+8801712345678

# Cloudflare R2 (S3-compatible) for avatars and file uploads. Keep real keys only in .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<id>.r2.dev
